# Build artifact (~9 MB) — attach to a GitHub Release instead of committing
*.exe
*.exe~

# Runtime data and user content, created/managed by the app at run time
/photos/
/logo/
/archives/
/_import_tmp/
*.pjs
*.pjss
/screens.json
/settings.json
/applog.txt
/photo-judge.properties

# Image files — never commit test photos or logos, wherever they land
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.tif
*.tiff
*.heic
*.heif

# Getting Started screenshots ARE part of the app (embedded into the exe), so keep
# them tracked even though images are otherwise ignored above.
!getting-started-images/
!getting-started-images/**

# Local dev helpers (not part of the app): CDP screenshot harness, mock servers,
# go test tmp dir
/cdp-shot.js
/mock-*.js
/.gotmp/

# OS / editor cruft
Thumbs.db
.DS_Store
